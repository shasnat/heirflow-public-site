# Marketing site (heirflow.com) environment configuration.
# Copy to .env and fill in real values. Do NOT commit real keys.

# Supabase project the marketing site reads from.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Origin of the HeirFlow app that marketing CTAs link to for signup.
# Optional — defaults to https://app.heirflow.com when unset.
# Point at a staging app origin for non-prod deploys.
VITE_APP_URL=https://app.heirflow.com
